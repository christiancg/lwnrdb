<?xml version="1.0"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<!--
  No main source is exempt from the 500-line FileLength limit. The debt list this file used to hold is
  empty: every oversized file has been split, so a new one fails the build. Do not add an entry here -
  split the file instead.
-->
<suppressions>
    <!-- Test sources are not subject to the file-length limit. -->
    <suppress files="[\\/]src[\\/]test[\\/]" checks="FileLength"/>
</suppressions>
