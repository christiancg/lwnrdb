<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Curated Checkstyle ruleset for LWNRDB.

  Formatting (indentation, wrapping, whitespace, import ordering) is owned by
  Spotless/Eclipse-JDT, so this config deliberately avoids those concerns and
  focuses on correctness-adjacent and convention checks that a formatter does
  not cover.
-->
<module name="Checker">
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- No tabs anywhere (Spotless enforces spaces, this is a backstop) -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <!-- A file nobody can read is a file nobody can review. This applies to main and test sources
         alike, with no exemptions: split the file rather than reintroducing a suppression list. -->
    <module name="FileLength">
        <property name="max" value="500"/>
    </module>

    <module name="TreeWalker">
        <!-- Imports. Static member wildcard imports are allowed: test classes
             use `import static org.junit.jupiter.api.Assertions.*` and
             `import static org.mockito.Mockito.*`, a widely accepted convention
             for assertion/mock readability. Regular type wildcard imports are
             still forbidden. -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>
        <module name="RedundantImport"/>
        <module name="UnusedImports">
            <property name="processJavadoc" value="true"/>
        </module>
        <module name="IllegalImport"/>
        <module name="PackageDeclaration"/>

        <!-- Tightened to 100 once the lexer/parser splits land. -->
        <module name="MethodLength">
            <property name="max" value="200"/>
            <property name="countEmpty" value="false"/>
        </module>
        <module name="LambdaBodyLength">
            <property name="max" value="60"/>
        </module>

        <!-- Coding problems -->
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="EqualsAvoidNull"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="UnnecessaryNullCheckWithInstanceOf"/>
        <module name="EmptyStatement"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="DefaultComesLast"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="NoFinalizer"/>
        <module name="NoClone"/>
        <module name="SuperClone"/>
        <module name="SuperFinalize"/>
        <module name="IllegalInstantiation"/>
        <module name="IllegalThrows"/>
        <module name="UnnecessarySemicolonInEnumeration"/>
        <module name="UnnecessarySemicolonInTryWithResources"/>
        <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>
        <module name="UnnecessarySemicolonAfterOuterTypeDeclaration"/>
        <module name="NoEnumTrailingComma"/>
        <module name="NoArrayTrailingComma"/>

        <!-- Nesting a block, a try or a loop that deep is a split waiting to happen.
             Both are set at the depth the tree already respects, so they only tighten. -->
        <module name="AvoidNestedBlocks"/>
        <module name="NestedTryDepth">
            <property name="max" value="2"/>
        </module>
        <module name="NestedForDepth">
            <property name="max" value="2"/>
        </module>

        <!-- Class design -->
        <module name="FinalClass"/>
        <module name="InterfaceIsType"/>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="OuterTypeNumber"/>
        <module name="MutableException"/>

        <!-- Style / conventions -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="MissingDeprecated"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <!-- Escapes that have a shorter, unambiguous form (\n, \t, \", \\) must use it,
             so an escape that survives in a literal is one that had to be written that way. -->
        <module name="IllegalTokenText">
            <property name="tokens" value="STRING_LITERAL, CHAR_LITERAL"/>
            <property name="format" value="\\u00(09|0(a|A)|0(c|C)|0(d|D)|22|27|5(C|c))|\\(0(10|11|12|14|15|42|47)|134)"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
            <property name="tokens" value="LITERAL_TRY, LITERAL_FINALLY, LITERAL_IF, LITERAL_ELSE, LITERAL_FOR, LITERAL_WHILE, LITERAL_DO, INSTANCE_INIT, STATIC_INIT"/>
        </module>

        <!-- A deliberately empty catch says so by naming its variable, not by carrying prose. -->
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="ignored|expected"/>
        </module>

        <!--
          Naming conventions, tuned to the project's deliberate conventions:
          - PackageName is excluded: package names use underscores by design
            (bckg_ops, custom_types, type_adapters, mid_operators).
          - MethodName allows snake_case: test methods use snake_case names, and
            the `_id` field is exposed via get_id/set_id accessors.
          - MemberName/ParameterName allow a leading underscore: `_id` is the
            serialized wire-protocol field name and cannot be renamed.
          - ConstantName is excluded: `private static final` collaborators and
            internal caches use camelCase by convention (logger, cache, config),
            not SCREAMING_CASE.
        -->
        <module name="TypeName"/>
        <module name="MethodName">
            <property name="format" value="^[a-z][a-zA-Z0-9_]*$"/>
        </module>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="MemberName">
            <property name="format" value="^_?[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="ParameterName">
            <property name="format" value="^_?[a-z][a-zA-Z0-9]*$"/>
        </module>
        <module name="StaticVariableName"/>
        <!-- The record/pattern/type-parameter half of the same conventions, which the
             checks above do not reach. -->
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="RecordTypeParameterName"/>
        <module name="ClassTypeParameterName"/>
        <module name="MethodTypeParameterName"/>
        <module name="InterfaceTypeParameterName"/>
    </module>
</module>
